{
  "name": "folderbot",
  "version": "2.0.1",
  "description": "Names and files TV episodes and movies, by hand or automatically from a watched folder",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron-ts,electron-app \"npm:dev:renderer\" \"npm:dev:electron:ts\" \"npm:dev:electron:app\"",
    "dev:renderer": "vite",
    "dev:electron:ts": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:app": "wait-on tcp:5173 file:dist-electron/main/main.js && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 nodemon --watch dist-electron --ext js --exec \"electron dist-electron/main/main.js\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "check:parser": "npm run build:electron && node scripts/check-parser.mjs",
    "check:storage": "npm run build:electron && node scripts/check-storage.mjs",
    "check:ui": "npm run build:renderer && node scripts/check-ui.mjs",
    "check": "npm run typecheck && npm run check:parser && npm run check:storage && npm run check:watcher && npm run check:ui",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "github:repo:init": "node scripts/github-init-repo.mjs",
    "github:release": "node scripts/github-publish-release.mjs",
    "check:watcher": "npm run build:electron && node scripts/check-watcher.cjs",
    "release": "npm run check && npm run build && electron-builder --win --x64 --publish always",
    "preview:ui": "npm run build:renderer && node scripts/ui-preview.mjs"
  },
  "keywords": [
    "electron",
    "media",
    "renamer",
    "tmdb",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.folderbot.app",
    "productName": "FolderBot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FolderBot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FolderBot",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "FolderBot",
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sparkserian",
        "repo": "FolderBot",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
